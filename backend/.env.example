# Supabase - Project Settings > Database > Connection string
# Cara termudah: salin "URI" dari dashboard lalu tempel di DATABASE_URL.
DATABASE_URL=

# Alternatif: isi field terpisah (dipakai bila DATABASE_URL kosong).
# Untuk Supabase:
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>               # pooler; atau "postgres" untuk direct
# DB_PASSWORD=<password-database>
# DB_HOST=aws-0-<region>.pooler.supabase.com   # atau db.<project-ref>.supabase.co
# DB_PORT=6543                                 # pooler; 5432 untuk direct
# DB_SSLMODE=require

# Catatan: jangan jalankan setup_db.py pada Supabase. Jalankan
# supabase/schema.sql lewat SQL Editor Supabase.
