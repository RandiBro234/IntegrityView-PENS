# Env untuk Edge Function saat dijalankan lokal (supabase functions serve).
# Salin menjadi supabase/.env.local lalu isi. File .env.local TIDAK di-commit
# (.gitignore: `.env.*`).
#
# Untuk produksi, nilai yang sama di-set lewat:
#   supabase secrets set LLM_API_KEY=... LLM_MODEL=... LLM_BASE_URL=...
#
# JANGAN menaruh nilai di bawah ini di frontend/ — semuanya rahasia.

# Otomatis tersedia di Edge Function produksi, tetapi perlu diisi untuk serve lokal.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Chatbot (fungsi `chat`)
# ---------------------------------------------------------------------------

# Penyedia LLM apa pun dengan endpoint kompatibel OpenAI:
#   POST {LLM_BASE_URL}/chat/completions
# Nama model HANYA di sini, tidak pernah di kode.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Header tambahan untuk agregator yang memerlukannya, sebagai JSON satu baris.
# Contoh: {"HTTP-Referer":"https://integrityview.local"}
LLM_EXTRA_HEADERS=

# Opsional. Untuk Gemini 2.5 isi "none" agar jatah token tidak habis untuk
# proses berpikir. Tidak dikirim bila kosong.
LLM_REASONING_EFFORT=

# Opsional: batas waktu, panjang keluaran, suhu, percobaan ulang.
# LLM_TIMEOUT_MS=20000
# LLM_MAX_TOKEN=300
# LLM_SUHU=0.1
# LLM_MAKS_COBA=3
# LLM_MAKS_TUNGGU_MS=6000

# 1 = pakai LLM palsu (balasan tetap, tanpa biaya, tanpa jaringan).
# "gagal" = mensimulasikan gangguan. Kosongkan untuk memanggil LLM sungguhan.
LLM_STUB=1

# Salt untuk hash IP di rate limit. Ganti dengan teks acak panjang.
RATE_LIMIT_SALT=

# Batas pemakaian chatbot.
CHAT_BATAS_PER_JAM=20
CHAT_BATAS_HARIAN=200
