# Supabase — Project Settings > API
# URL project, mis. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) dari tab "Publishable and secret API keys".
# Bisa juga legacy anon key (eyJ...). JANGAN pakai secret key (sb_secret_...).
VITE_SUPABASE_ANON_KEY=
# Data simulasi untuk (instrumen, periode) yang belum punya baris asli.
# Set "false" untuk menampilkan keadaan kosong.
VITE_ENABLE_SIMULATION=true
# Seed pengaduan/WBS demo. Set "false" di produksi agar hanya data asli
# (dan mirror localStorage) yang tampil.
VITE_ENABLE_DEMO_LAPORAN=true

# Endpoint chatbot "Tanya Ivy".
# Kosongkan untuk memakai jawaban contoh (tanpa backend).
# Saat pengembangan: jalankan `node --experimental-strip-types scripts/serve-chat.mjs`
# lalu isi VITE_CHAT_API_URL=http://127.0.0.1:8787
# Di produksi: kosongkan bila Edge Function `chat` sudah di-deploy ke project
# Supabase yang sama — frontend otomatis memakai /functions/v1/chat.
VITE_CHAT_API_URL=
